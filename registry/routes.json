{
  "about": "Which skill at which moment. Curated by hand. The backbone is the software lifecycle of addyosmani/agent-skills (define, plan, build, verify, review, ship): each phase has one agent-skills owner, and stack, UI, security and simplicity skills attach to a phase as specialists. The agent-skills router text is not loaded; this file is the router. Where an agent-skills skill disagrees with the user's rules (when tests are written, when to commit, how much ceremony a small task gets), the user's rules win. `listed` skills are visible to every agent; every other skill is reached through a route or `narvai skill <name>`. `@project-design` is the design skill named in the project profile. At most three skills per route.",
  "phases": {
    "define": "Small tasks skip it. Used when the request is unclear or the work is large.",
    "plan": "Three or more files, or a contract change. Otherwise skip.",
    "build": "Every code change. The owner is used for multi-file work; specialists attach by file type.",
    "verify": "Every code change: `narvai verify`, `narvai tests`, and the owner on any failure.",
    "review": "Only after the user says yes to a review, except the self-check at `done`.",
    "ship": "Only when the user asks for a commit, push or pull request."
  },
  "listed": [
    "narvai-orchestrator",
    "unslop",
    "caveman",
    "interview-me",
    "spec-driven-development",
    "planning-and-task-breakdown",
    "incremental-implementation",
    "debugging-and-error-recovery"
  ],
  "routes": [
    {
      "id": "unclear",
      "phase": "define",
      "when": {
        "event": "unclear"
      },
      "skills": [
        "interview-me"
      ],
      "why": "the request does not say who, why, what done looks like or the binding constraint"
    },
    {
      "id": "idea",
      "phase": "define",
      "when": {
        "event": "idea"
      },
      "skills": [
        "idea-refine"
      ],
      "why": "an idea to shape before it is a requirement"
    },
    {
      "id": "plan",
      "phase": "plan",
      "when": {
        "event": "plan"
      },
      "skills": [
        "spec-driven-development",
        "planning-and-task-breakdown"
      ],
      "why": "work that touches three or more files or changes a contract"
    },
    {
      "id": "build",
      "phase": "build",
      "when": {
        "event": "build"
      },
      "skills": [
        "incremental-implementation"
      ],
      "why": "multi-file implementation in small verifiable slices"
    },
    {
      "id": "library",
      "phase": "build",
      "when": {
        "event": "library"
      },
      "skills": [
        "source-driven-development"
      ],
      "why": "code against an external library or framework API: read its current documentation first (Context7)"
    },
    {
      "id": "interface",
      "phase": "build",
      "when": {
        "event": "edit",
        "paths": [
          "**/*Endpoints.cs",
          "**/*Controller.cs",
          "**/Contracts/**/*.cs"
        ]
      },
      "skills": [
        "api-and-interface-design",
        "dotnet-webapi"
      ],
      "why": "a public endpoint or contract changes"
    },
    {
      "id": "ui",
      "phase": "build",
      "when": {
        "event": "edit",
        "paths": [
          "**/*.tsx",
          "**/*.jsx",
          "**/*.css",
          "**/*.scss"
        ]
      },
      "skills": [
        "@project-design",
        "impeccable",
        "modern-web-guidance"
      ],
      "why": "UI work"
    },
    {
